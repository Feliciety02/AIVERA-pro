# AEGIS AI frontend configuration
# "demo" = all data comes from the in-browser demo adapter (default; no network calls).
# "api"  = future backend adapter (Node.js/Express). Not implemented in this phase.
VITE_DATA_MODE=demo

# Future backend base URL (used only by the API adapter once it exists).
# Never put secrets, API keys or scanner credentials in frontend env vars —
# everything prefixed with VITE_ is shipped to the browser.
VITE_API_BASE_URL=http://localhost:4000/api
