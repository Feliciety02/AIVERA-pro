# AIVERA backend configuration. Copy to server/.env and adjust.
# server/.env is git-ignored; never commit real secrets.

# Local development database (SQLite file next to the Prisma schema).
DATABASE_URL="file:./dev.db"
# MySQL example (also change provider in server/prisma/schema.prisma):
# DATABASE_URL="mysql://aegis:password@localhost:3306/aegis"

PORT=4000
NODE_ENV=development

# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Google Gemini API (AI analysis). Leave empty to use the labelled demo samples.
# Get a key at https://aistudio.google.com/apikey. Never commit it or put it in a VITE_ variable.
# Free tier note: Google states free-tier content may be used to improve its products,
# AIVERA redacts secrets before sending; still use only test/synthetic data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Enable automated passive assessments only on a dedicated, authorized lab host.
# Requires Nmap on PATH, Docker on PATH, and the ZAP stable image pulled locally.
AIVERA_LIVE_SCANS_ENABLED=false
# Exact hostnames/IPs the lab administrator allows this server to contact.
AIVERA_ALLOWED_SCAN_HOSTS=

# Password given to every seeded demo account by `npm run db:seed`.
# Test-only value for local development, change it for any shared deployment.
SEED_DEMO_PASSWORD="AegisDemo#2026"
# Windows installs: full paths (use forward slashes) when the tools aren't on PATH. With AIVERA_ZAP_PATH set,
# AIVERA runs the installed ZAP directly instead of Docker.
AIVERA_NMAP_PATH=
AIVERA_ZAP_PATH=
AIVERA_JAVA_PATH=

# AI fallback. If GEMINI_MODEL is busy, these Gemini models are tried next (same key).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# Optional second provider (OpenAI-compatible chat API), tried after all Gemini models.
# Groq (free key at console.groq.com): AI_FALLBACK_BASE_URL=https://api.groq.com/openai/v1, AI_FALLBACK_MODEL=<a model from Groq's list>
# Local Ollama (nothing leaves this PC): AI_FALLBACK_BASE_URL=http://localhost:11434/v1, AI_FALLBACK_MODEL=<a model you pulled with ollama pull>, no key
AI_FALLBACK_NAME=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
# Local models can take a minute or two to load on first use: allow up to 150 s for the fallback provider.
AI_FALLBACK_TIMEOUT_MS=150000
# A second backup is tried after the first: same settings with AI_FALLBACK_2_ (and AI_FALLBACK_3_).
AI_FALLBACK_2_NAME=
AI_FALLBACK_2_BASE_URL=
AI_FALLBACK_2_API_KEY=
AI_FALLBACK_2_MODEL=
AI_FALLBACK_2_TIMEOUT_MS=
