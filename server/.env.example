# AEGIS AI backend configuration. Copy to server/.env and adjust.
# server/.env is git-ignored; never commit real secrets.

# Local development database (SQLite file next to the Prisma schema).
DATABASE_URL="file:./dev.db"
# MySQL example (also change provider in server/prisma/schema.prisma):
# DATABASE_URL="mysql://aegis:password@localhost:3306/aegis"

PORT=4000
NODE_ENV=development

# Session lifetime in hours.
SESSION_TTL_HOURS=8

# Google Gemini API (AI analysis). Leave empty to use the labelled demo samples.
# Get a key at https://aistudio.google.com/apikey. Never commit it or put it in a VITE_ variable.
# Free tier note: Google states free-tier content may be used to improve its products —
# AEGIS redacts secrets before sending; still use only test/synthetic data.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Password given to every seeded demo account by `npm run db:seed`.
# Test-only value for local development — change it for any shared deployment.
SEED_DEMO_PASSWORD="AegisDemo#2026"
