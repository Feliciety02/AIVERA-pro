{
  "name": "aivera",
  "private": true,
  "version": "0.1.0",
  "description": "AIVERA — Intelligent Web Security Assessment & Vulnerability Management Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "dev:full": "concurrently -n api,web -c blue,green \"npm run server:dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "build:api": "tsc -b && vite build --mode api",
    "typecheck": "tsc -b --noEmit && tsc -p server/tsconfig.json",
    "test:scan-scope": "node --import tsx --test server/src/automatedAssessment.test.ts",
    "preview": "vite preview",
    "server:dev": "tsx watch --tsconfig server/tsconfig.json server/src/index.ts",
    "server:start": "tsx --tsconfig server/tsconfig.json server/src/index.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node --env-file=server/.env node_modules/prisma/build/index.js db push",
    "db:seed": "tsx --tsconfig server/tsconfig.json server/src/seed.ts",
    "db:setup": "prisma db push && npm run db:seed"
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.5",
    "@google/genai": "^3.1.0",
    "@hookform/resolvers": "^5.1.1",
    "@prisma/client": "^6.16.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.1.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "helmet": "^8.1.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.525.0",
    "radix-ui": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.60.0",
    "react-router": "^7.6.3",
    "recharts": "^3.1.0",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^9.2.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.3.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
